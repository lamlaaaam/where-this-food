# Browser key: Maps JavaScript API only.
# Restrict by HTTP referrer:
#   http://localhost:5173/*
#   https://<your-github-username>.github.io/*
# This value is compiled into the deployed browser bundle.
VITE_GOOGLE_MAPS_API_KEY=your_browser_key_here

# Generator key: Maps JavaScript API + Places API (New).
# Used only by scripts/generateDailyPuzzle.mjs and GitHub Actions.
# This value is NOT VITE_-prefixed, so Vite never bundles it.
# Restrict by HTTP referrer to http://localhost:5173/*, or leave unrestricted.
GOOGLE_MAPS_API_KEY=your_generator_key_here
